# npx wrangler dev 로 실행할 때: 이 파일을 .dev.vars 로 복사해 본인 값을 넣으세요. (.dev.vars는 올리지 마세요)
# 배포할 때는 npx wrangler secret put 이름 으로 하나씩 넣습니다.

# 필수
APP_PASSWORD=
FINNHUB_KEY=

# 선택: 비워 두면 해당 기능만 쉬거나 대체 출처를 씁니다
SEC_CONTACT=
GEMINI_KEY=
MASSIVE_KEY=
FRED_KEY=
NEWSAPI_KEY=
# Gemini 대신 Claude를 쓸 때
#AI_PROVIDER=anthropic
#ANTHROPIC_KEY=
